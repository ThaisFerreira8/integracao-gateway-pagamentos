DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=integracao_gateway_pagamentos

# Origem permitida para as requisições do frontend.
FRONTEND_URL=http://localhost:5173

# Segredo exclusivo da sessão BaaS. Gere um valor aleatório com pelo menos 32 bytes.
# Deve ser preenchido no ambiente local; não reutilize credenciais do gateway.
JWT_SECRET=

# Duração do token da aplicação em segundos (3600 = 1 hora).
JWT_EXPIRES_IN_SECONDS=3600

# Chave mestra AES-256-GCM: 32 bytes aleatórios, representados por 64 caracteres hexadecimais.
# Gere uma chave própria, distinta do JWT_SECRET, e mantenha-a fora do Git.
# A chave é obrigatória na inicialização; não há valor padrão.
GATEWAY_ENCRYPTION_KEY=

# Endereço HTTPS do gateway.
GATEWAY_BASE_URL=https://api.branchpay.com.br

# Timeout das futuras requisições ao gateway, em milissegundos.
GATEWAY_TIMEOUT_MS=10000
