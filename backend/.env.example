DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=integracao_gateway_pagamentos

# Origem permitida para as requisições do frontend.
FRONTEND_URL=http://localhost:5173

# Segredo exclusivo da sessão BaaS. Gere um valor aleatório com pelo menos 32 bytes.
# Deve ser preenchido no ambiente local; não reutilize credenciais do gateway.
JWT_SECRET=

# Duração do token da aplicação em segundos (3600 = 1 hora).
JWT_EXPIRES_IN_SECONDS=3600
